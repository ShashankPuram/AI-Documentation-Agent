name: AI Documentation Agent

on:
  push:
    branches:
      - main

jobs:
  documentation:
    runs-on: ubuntu-latest

    steps:

      # ---------------------------------------------------------
      # Checkout repository
      # ---------------------------------------------------------
      - name: Checkout repository
        uses: actions/checkout@v4

      # ---------------------------------------------------------
      # Setup Python
      # ---------------------------------------------------------
      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      # ---------------------------------------------------------
      # Install Graphviz
      # ---------------------------------------------------------
      - name: Install Graphviz
        run: |
          sudo apt-get update
          sudo apt-get install -y graphviz

      # ---------------------------------------------------------
      # Install Python dependencies
      # ---------------------------------------------------------
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r backend/requirements.txt

      # ---------------------------------------------------------
      # Run AI Documentation Agent
      # ---------------------------------------------------------
      - name: Run documentation agent
        env:
          LLM_PROVIDER: api
          LLM_API_URL: https://api.baiduqianfan.ai/v2/tokenplan/team/chat/completions
          LLM_API_KEY: ${{ secrets.FLUXA_API_KEY }}
          LLM_MODEL: deepseek-v4-flash
        run: |
          python backend/agent.py .

      # ---------------------------------------------------------
      # Verify workflow
      # ---------------------------------------------------------
      - name: Verify workflow
        run: |
          echo "AI Documentation Agent completed successfully"